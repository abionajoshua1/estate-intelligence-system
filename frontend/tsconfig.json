{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],

    "jsx": "react-jsx",

    "moduleResolution": "bundler",

    "allowJs": true,
    "checkJs": false,

    "strict": false,
    "skipLibCheck": true,

    "noEmit": true,

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"]
    },

    "ignoreDeprecations": "6.0"
  },

  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}